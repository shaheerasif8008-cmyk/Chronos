# Deployment environment. Keep "development" for local work. Any other value
# (e.g. "production") activates startup guards that REFUSE TO BOOT on insecure
# defaults: the dev JWT secret, an unset/all-zeros vault key, or dev OTP auth.
ENVIRONMENT=development
ORG_ID=default
REGION=us
ADMIN_EMAIL=admin@example.com

DATABASE_URL=postgresql+asyncpg://chronos:chronos@localhost:55432/chronos
REDIS_URL=redis://localhost:6379

# Object storage: AWS S3 (boto3). Defaults below point at the local MinIO
# service in docker-compose.yml — an S3-compatible server for dev. In production,
# clear AWS_S3_ENDPOINT and supply real AWS S3 credentials (or use a runtime
# secret manager / instance role, in which case the key/secret can stay blank).
OBJECT_STORAGE_BACKEND=s3
AWS_S3_BUCKET=chronos-dev
AWS_S3_REGION=us-east-1
AWS_S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=chronos
AWS_SECRET_ACCESS_KEY=chronos123
AWS_SESSION_TOKEN=

LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3
BACKUP_API_KEY=
BACKUP_MODEL=openrouter/minimax/minimax-m2.5:free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/openai/gpt-5.4-nano
AGENT_MODEL=openrouter/deepseek/deepseek-v4-pro
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
EMBEDDING_MODEL=google/gemini-embedding-2
EMBEDDING_DIMENSIONS=1536
FAST_MODEL=openrouter/openai/gpt-5.4-nano
VISION_MODEL=            # vision-capable model for OCR; empty disables OCR
IMAGE_MODEL=             # image generation model (e.g. openai/dall-e-3); empty disables generation
STT_MODEL=               # speech-to-text model (e.g. openai/whisper-1); empty disables STT
TTS_MODEL=               # text-to-speech model (e.g. openai/tts-1); empty disables TTS

# Demo mode uses fixture connector data so local tasks can run end-to-end without Composio/OAuth.
DEMO_MODE=true

# Dev-only placeholder. In production set a strong random secret (e.g.
# `openssl rand -hex 32`); the app refuses to boot with this value when
# ENVIRONMENT is not "development".
JWT_SECRET=change-me-in-dev
ACCESS_TOKEN_EXPIRE_MINUTES=60

TASK_RUNNER_MAX_CONCURRENCY=4
TASK_RUNNER_MAX_ATTEMPTS=2
TASK_RUNNER_TIMEOUT_SECONDS=1800

# Auth: dev_otp | cognito | both
AUTH_PROVIDER=dev_otp
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_APP_CLIENT_SECRET=
COGNITO_DOMAIN=
COGNITO_CALLBACK_URL=http://localhost:3000/login/callback
COGNITO_AUTO_PROVISION_MEMBERS=false
# 32-byte key as 64 hex chars. REQUIRED outside development — generate with
# `openssl rand -hex 32` and keep it secret (it decrypts all connector
# credentials). Left blank here on purpose so a misconfigured prod fails loudly
# rather than encrypting every tenant's secrets under a publicly known key.
VAULT_ENCRYPTION_KEY=

# Authorization (OpenFGA). Enforcement is OFF by default: permission.check is an
# allow-all stub that still audits. The OpenFGA server ships in docker-compose.yml.
# To turn real project-scoped enforcement ON, do it in TWO steps, in order:
#   1. Set OPENFGA_API_URL (with OpenFGA running). From now on, creating members
#      and projects writes the matching relationship tuples. Leave enforcement off
#      and run normally for a while so tuples accumulate.
#   2. Later, set PERMISSIONS_ENFORCE=true to start checking those tuples.
# Caveat: there is NO backfill. Projects created BEFORE step 1 have no tuples, so
# their owners get a hard deny once step 2 is on. Either enable step 1 on a fresh
# DB, or re-grant existing projects (permissions.grant_project_role) before step 2.
# When enforcement is on and OpenFGA is unreachable, checks fail CLOSED.
# OPENFGA_API_URL=http://localhost:8080
# PERMISSIONS_ENFORCE=false

# Google OAuth2 for Gmail, Calendar, and Drive.
# Add this exact URI to the OAuth client's Authorized redirect URIs in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/connectors/gmail/oauth-callback

# OAuth2 app connectors.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
AIRTABLE_CLIENT_ID=
AIRTABLE_CLIENT_SECRET=
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
STRIPE_CLIENT_ID=
STRIPE_CLIENT_SECRET=

# Non-OAuth connector setup.
WEBHOOK_SIGNING_KEY=
WEBHOOK_SIGNING_SECRET=
CUSTOM_HTTP_API_BASE=
CUSTOM_HTTP_API_KEY=
REMOTE_MCP_URL=
REMOTE_MCP_TOKEN=

# Live web search for browser.search.
TAVILY_API_KEY=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
SENTRY_DSN=
SENDGRID_API_KEY=
