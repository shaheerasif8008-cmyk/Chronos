# Deployment environment. Keep "development" for local work. Any other value
# (e.g. "production") activates startup guards that REFUSE TO BOOT on insecure
# defaults: the dev JWT secret, an unset/all-zeros vault key, or dev OTP auth.
ENVIRONMENT=development
ORG_ID=default
REGION=us
BASE_DOMAIN=cognisiatech.com
ADMIN_EMAIL=admin@example.com

DATABASE_URL=postgresql+asyncpg://chronos:chronos@localhost:55432/chronos
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
# Local Postgres does not require TLS. Production RDS must use "require" or
# "verify-full" with a trusted CA bundle.
DB_SSL_MODE=
REDIS_URL=redis://localhost:6379

# Object storage: AWS S3 (boto3). Defaults below point at the local MinIO
# service in docker-compose.yml — an S3-compatible server for dev. In production,
# clear AWS_S3_ENDPOINT and supply real AWS S3 credentials (or use a runtime
# secret manager / instance role, in which case the key/secret can stay blank).
OBJECT_STORAGE_BACKEND=s3
AWS_S3_BUCKET=chronos-dev
AWS_S3_REGION=us-east-1
AWS_S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=chronos
AWS_SECRET_ACCESS_KEY=chronos123
AWS_SESSION_TOKEN=

LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3
BACKUP_API_KEY=
# Direct Anthropic fallback. Production rejects an OpenRouter-prefixed backup,
# because that would share the primary provider's failure domain.
BACKUP_MODEL=anthropic/claude-sonnet-5
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/openai/gpt-5.4-nano
AGENT_MODEL=openrouter/deepseek/deepseek-v4-pro
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
EMBEDDING_MODEL=google/gemini-embedding-2
EMBEDDING_DIMENSIONS=1536
FAST_MODEL=openrouter/openai/gpt-5.4-nano
# OpenRouter multimodal defaults use the dedicated Images, Transcriptions, and
# Speech APIs. Prefixing with openrouter/ selects the direct HTTP contracts;
# other provider model IDs continue through LiteLLM.
VISION_MODEL=openrouter/openai/gpt-4o-mini
IMAGE_MODEL=openrouter/google/gemini-3.1-flash-image
STT_MODEL=openrouter/openai/gpt-4o-mini-transcribe
TTS_MODEL=openrouter/x-ai/grok-voice-tts-1.0
LOCAL_LLM_TIMEOUT_SECONDS=2
MEMORY_RETRIEVE_TIMEOUT_SECONDS=1.5

# Demo mode uses fixture connector data so local tasks can run end-to-end without Composio/OAuth.
DEMO_MODE=true

# Dev-only placeholder. In production set a strong random secret (e.g.
# `openssl rand -hex 32`); the app refuses to boot with this value when
# ENVIRONMENT is not "development".
JWT_SECRET=change-me-in-dev
ACCESS_TOKEN_EXPIRE_MINUTES=60

TASK_RUNNER_MAX_CONCURRENCY=4
TASK_RUNNER_MAX_ATTEMPTS=2
TASK_RUNNER_TIMEOUT_SECONDS=1800
TASK_LEASE_TTL_SECONDS=120
TASK_LEASE_HEARTBEAT_SECONDS=30
TASK_REAPER_INTERVAL_SECONDS=60
RUNTIME_AUTO_INSTALL_TOOLS=true
RUNTIME_TOOL_INSTALL_TIMEOUT_SECONDS=180
# Required for production cloud-computer and isolated code/data execution.
E2B_API_KEY=
E2B_TEMPLATE_ID=
E2B_SANDBOX_TIMEOUT_SECONDS=1800
# Code, data, and bundled skill sandboxes always remain offline. This legacy
# value is retained for compatibility and is intentionally ignored by them.
E2B_ALLOW_INTERNET_ACCESS=false
# Cloud-computer sessions use a dedicated desktop template and pause/resume
# profile. The template must contain Xvfb, XFCE, scrot, and xdotool.
E2B_COMPUTER_ALLOW_INTERNET_ACCESS=true
# Organization ceiling; each network-enabled session must request a confirmed
# exact-domain subset. Wildcards are allowed here but never in user consent.
E2B_COMPUTER_EGRESS_ALLOWLIST=github.com,api.github.com,pypi.org,files.pythonhosted.org,registry.npmjs.org
E2B_COMPUTER_TEMPLATE_ID=
E2B_COMPUTER_IDLE_TIMEOUT_SECONDS=900
E2B_COMPUTER_MAX_SESSION_SECONDS=14400
E2B_COMPUTER_MAX_ACTIVE_PER_MEMBER=2
E2B_COMPUTER_MAX_ACTIVE_PER_ORG=20
E2B_COMPUTER_SCREEN_WIDTH=1280
E2B_COMPUTER_SCREEN_HEIGHT=800
# Persistent coding workspaces use a distinct E2B template/profile. Production
# requires these values; git/package egress is scoped to this profile only.
E2B_REPO_ENABLED=false
E2B_REPO_TEMPLATE_ID=
E2B_REPO_ALLOW_INTERNET_ACCESS=false
E2B_REPO_EGRESS_ALLOWLIST=github.com,api.github.com,codeload.github.com,objects.githubusercontent.com,raw.githubusercontent.com,pypi.org,files.pythonhosted.org,registry.npmjs.org
E2B_REPO_TIMEOUT_SECONDS=21600
E2B_REPO_COMMAND_TIMEOUT_SECONDS=300
E2B_REPO_MAX_SNAPSHOT_BYTES=52428800
E2B_REPO_MAX_WORKSPACES_PER_ORG=50
E2B_REPO_MAX_WORKSPACES_PER_TASK=3
# Required in production. The API connects only to the private/loopback clamd
# sidecar and rejects every ingress byte when health/signatures are unavailable.
MALWARE_SCAN_REQUIRED=true
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=20
CLAMAV_MAX_BYTES=52428800
CLAMAV_MAX_SIGNATURE_AGE_HOURS=48

# Auth: dev_otp | cognito | both
AUTH_PROVIDER=dev_otp
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_APP_CLIENT_SECRET=
COGNITO_DOMAIN=
# Optional token-validation overrides for custom-domain/multi-region Cognito.
# Blank uses https://cognito-idp.<region>.amazonaws.com/<pool-id> and its JWKS.
COGNITO_ISSUER_URL=
COGNITO_JWKS_URL=
COGNITO_CALLBACK_URL=http://localhost:3000/login/callback
COGNITO_AUTO_PROVISION_MEMBERS=false
SSO_ENDPOINT_HOST_ALLOWLIST=
FRONTEND_BASE_URL=http://localhost:3000
# Production rejects legacy session tokens that are not bound to an org. A
# short ISO-8601 grace timestamp may be used only during an existing-user rollout.
ENFORCE_ORG_BOUND_TOKENS=true
ORG_BOUND_TOKENS_GRACE_UNTIL=
# 32-byte key as 64 hex chars. REQUIRED outside development — generate with
# `openssl rand -hex 32` and keep it secret (it decrypts all connector
# credentials). Left blank here on purpose so a misconfigured prod fails loudly
# rather than encrypting every tenant's secrets under a publicly known key.
VAULT_ENCRYPTION_KEY=

# Composio managed auth. Set COMPOSIO_API_KEY to route ALL external SaaS
# connectors (Gmail, Slack, Notion, GitHub, HubSpot, Linear, Jira, Calendar,
# Drive, Outlook, Salesforce, Stripe, …) through Composio. Composio holds the
# OAuth tokens; Chronos stores only a per-entity reference. When this is unset,
# connectors fall back to the direct OAuth + generic HTTP path below.
# Native tools (browser, filesystem, code, computer) never route through Composio.
COMPOSIO_API_KEY=
# Connection granularity: "member" = each user authorises their own accounts;
# "org" = one shared connection per organization.
COMPOSIO_ENTITY_SCOPE=member
COMPOSIO_CALLBACK_BASE_URL=http://localhost:8000
OAUTH_CALLBACK_BASE_URL=http://localhost:8000

# Google OAuth2 for Gmail, Calendar, and Drive (used only when COMPOSIO_API_KEY is unset).
# Add this exact URI to the OAuth client's Authorized redirect URIs in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/connectors/gmail/oauth-callback

# OAuth2 app connectors.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
TEAMS_BOT_APP_ID=
TEAMS_BOT_JWKS_URL=https://login.botframework.com/v1/.well-known/keys
TEAMS_BOT_ISSUER=https://api.botframework.com
SENDGRID_INBOUND_PUBLIC_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
AIRTABLE_CLIENT_ID=
AIRTABLE_CLIENT_SECRET=
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
STRIPE_CLIENT_ID=
STRIPE_CLIENT_SECRET=

# Non-OAuth connector setup.
WEBHOOK_SIGNING_KEY=
WEBHOOK_SIGNING_SECRET=
CUSTOM_HTTP_API_BASE=
CUSTOM_HTTP_API_KEY=
REMOTE_MCP_URL=
REMOTE_MCP_TOKEN=

# Live web search for browser.search.
TAVILY_API_KEY=
BROWSERBASE_API_KEY=
BROWSERBASE_OPERATOR_ENABLED=false
BROWSERBASE_PROJECT_ID=
BROWSERBASE_REGION=us-east-1
BROWSERBASE_SESSION_TIMEOUT_SECONDS=14400
BROWSERBASE_SEARCH_URL=https://api.browserbase.com/v1/search

# Authorization (OpenFGA). An empty URL intentionally disables relationship
# checks for local development. Production must set the private service URL,
# keep PERMISSIONS_ENFORCE=true, and reconcile existing tuples before traffic.
OPENFGA_API_URL=
OPENFGA_API_TOKEN=
OPENFGA_STORE_ID=
OPENFGA_MODEL_ID=
PERMISSIONS_ENFORCE=true

# Agent/runtime budgets. A zero daily token limit means unlimited and is not a
# safe production setting; choose an explicit per-org ceiling before launch.
CONCURRENT_SUB_AGENTS=5
AGENT_COGNITION_ENABLED=true
AGENT_MAX_REFLECTIONS=2
AGENT_MAX_REPLANS=3
MAX_CONTEXT_TOKENS=120000
RESPONSE_RESERVE_TOKENS=4000
PER_ORG_DAILY_TOKEN_LIMIT=0

# Durable monitor polling bounds. Keep the lease longer than the fetch timeout;
# Postgres leases and run keys remain the duplicate-prevention boundary.
MONITOR_POLL_INTERVAL_SECONDS=30
MONITOR_MIN_INTERVAL_SECONDS=60
MONITOR_MAX_INTERVAL_SECONDS=86400
MONITOR_MAX_PER_ORG=100
MONITOR_MAX_RUNS_PER_ORG_CYCLE=10
MONITOR_FETCH_TIMEOUT_SECONDS=15
MONITOR_FETCH_MAX_BYTES=1048576
MONITOR_LEASE_SECONDS=90

# Safe rich-artifact preview and durable project bundle ceilings. Preview
# rendering never executes document macros, formulas, notebook cells, or script.
ARTIFACT_PREVIEW_MAX_BYTES=26214400
ARTIFACT_PREVIEW_MAX_UNCOMPRESSED_BYTES=104857600
ARTIFACT_PREVIEW_MAX_PDF_PAGES=50
PROJECT_EXPORT_MAX_BYTES=104857600
PROJECT_EXPORT_MAX_ARTIFACTS=500

# Billing is truthful-degraded when blank. Configure all four values together
# before presenting paid plans in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
SENTRY_DSN=
# Web error monitoring reuses SENTRY_DSN on the server. The public form is
# embedded only at web build time (via a BuildKit secret in production).
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_CHRONOS_ENVIRONMENT=development
NEXT_PUBLIC_CHRONOS_RELEASE=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_SUPPORT_URL=
NEXT_PUBLIC_STATUS_URL=

# Client-facing URLs are required in production by the API config guard. They
# must point to published, owner-approved documents/channels.
TERMS_URL=
PRIVACY_URL=
SUPPORT_URL=
STATUS_URL=
ARTIFACT_SHARE_TTL_HOURS=168
SENDGRID_API_KEY=
NOTIFICATION_FROM_EMAIL=
